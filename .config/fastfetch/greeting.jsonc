{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "position": "top",
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "  OS->",
      "keyColor": "1;32"
    },
    {
      "type": "kernel",
      "key": "├  ->",
      "keyColor": "32"
    },
    {
      "type": "uptime",
      "key": "├  ->",
      "keyColor": "32"
    },
    {
      "type": "packages",
      "key": "├  ->",
      "keyColor": "32"
    },
    {
      "type": "shell",
      "key": "└  ->",
      "keyColor": "32"
    },
    "break",
    {
      "type": "wm",
      "key": "  WM->",
      "keyColor": "1;36"
    },
    {
      "type": "theme",
      "key": "├  ->",
      "keyColor": "36"
    },
    {
      "type": "cursor",
      "key": "├  ->",
      "keyColor": "36"
    },
    {
      "type": "terminal",
      "key": "└  ->",
      "keyColor": "36"
    },
    "break",
    {
      "type": "host",
      "key": "  PC->",
      "keyColor": "1;34"
    },
    {
      "type": "cpu",
      "key": "├  ->",
      "keyColor": "34"
    },
    {
      "type": "gpu",
      "key": "├ 󰢮 ->",
      "keyColor": "34"
    },
    {
      "type": "memory",
      "key": "├  ->",
      "keyColor": "34"
    },
    {
      "type": "swap",
      "key": "├  ->",
      "keyColor": "34"
    },
    {
      "type": "disk",
      "key": "├ 󰋊 ->",
      "keyColor": "34"
    },
    {
      "type": "display",
      "key": "├  ->",
      "keyColor": "34"
    },
    {
      "type": "battery",
      "key": "└  ->",
      "keyColor": "34"
    },
    "break",
    "colors"
  ]
}
